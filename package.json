{
  "name": "tmzn.io",
  "description": "Find the client's timezone for your time",
  "version": "0.1.0",
  "homepage": "https://tmzn.in",
  "author": {
    "name": "Marc Went",
    "url": "https://went.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dunky13/tmzn.in.git"
  },
  "license": "GNU GPL3",
  "bugs": {
    "url": "https://github.com/Dunky13/tmzn.in/issues"
  },
  "keywords": [
    "html5",
    "css3",
    "es6",
    "frontend",
    "sass",
    "less",
    "static",
    "boilerplate",
    "webpack"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve --config ./config/webpack.config.js",
    "start:dist": "cross-env NODE_ENV=production webpack serve --config ./config/webpack.config.js",
    "setup": "node ./config/site.setup.js",
    "postinstall": "node ./config/site.setup.js --install",
    "lint:js": "./node_modules/.bin/eslint \"src/**/*.js\"",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "build:dist": "cross-env NODE_ENV=production webpack --config ./config/webpack.config.js",
    "deploy": "node ./config/site.deploy.js",
    "test": "cross-env TZ=UTC node --test --test-concurrency=1"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "autoprefixer": "10.6.1",
    "babel-loader": "10.1.1",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-webpack-plugin": "4.2.0",
    "favicons": "7.3.1",
    "favicons-webpack-plugin": "6.0.1",
    "glob": "13.0.6",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.8",
    "image-minimizer-webpack-plugin": "5.0.0",
    "less": "4.9.1",
    "less-loader": "13.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.31",
    "postcss-loader": "8.2.1",
    "postcss-scss": "4.0.9",
    "robotstxt-webpack-plugin": "8.0.0",
    "sass": "1.106.1",
    "sass-loader": "17.0.1",
    "sharp": "0.35.5",
    "sitemap-webpack-plugin": "1.1.1",
    "style-loader": "4.0.0",
    "stylelint": "17.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-scss": "7.3.0",
    "stylelint-webpack-plugin": "5.1.0",
    "svgo": "4.1.0",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.1.0",
    "jsdom": "30.1.3"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "clear": "^0.1.0",
    "enquirer": "2.4.1",
    "figlet": "1.12.0",
    "jquery": "^3.4.1",
    "luxon": "^1.25.0",
    "normalize.css": "^8.0.1",
    "reset-css": "^4.0.1",
    "sanitize.css": "^11.0.0"
  },
  "engines": {
    "node": "26.12.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
